# ─── Required ─────────────────────────────────────────────
# OpenAI API key (used for comment and post generation)
OPENAI_API_KEY=sk-your-key-here

# ─── LinkedIn Credentials (Option A: use profile manager) ─
# Run: python linkedin_profile_manager.py add
# This stores credentials encrypted in data/profiles/profiles.json
# You can add multiple profiles for different LinkedIn accounts

# ─── LinkedIn Credentials (Option B: .env auto-migrate) ────
# If you set these, they auto-migrate to a "default" profile on first run
# LINKEDIN_USERNAME=your-email@example.com
# LINKEDIN_PASSWORD=your-password

# ─── For a second LinkedIn account (optional) ─────────────
# LINKEDIN_ALT_USERNAME=alt-email@example.com
# LINKEDIN_ALT_PASSWORD=alt-password

# ─── Cloudflare R2 (image hosting for the scheduled-posting hybrid) ──────────
# Buffer needs a PUBLICLY FETCHABLE image URL and reads the bytes at createPost
# time, so the CSV's local image_path is uploaded to R2 first.
#
# NOTE the two URLs are DIFFERENT and neither is derivable from the other:
#   R2_ENDPOINT         - the authenticated S3 API, for UPLOADS only.
#                         Nothing public is ever served from this host.
#   R2_PUBLIC_BASE_URL  - what the public actually fetches. Either the bucket's
#                         r2.dev development URL or a custom domain.
# Handing Buffer an R2_ENDPOINT link would fail: it is not publicly readable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
